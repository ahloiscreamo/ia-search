# --- Open / Play / Download Item ---
open_item() {
    local identifier="$1"
    echo "${ICON_OPEN} Fetching file list for: $identifier ..."

    local metadata
    if ! metadata=$(curl -fsSL "https://archive.org/metadata/$(urlencode "$identifier")" 2>/dev/null) ||
        ! jq -e 'type == "object"' >/dev/null 2>&1 <<< "$metadata"; then
        echo "${ICON_WARNING} No files found for this item or failed to fetch."
        sleep 2
        return
    fi

    # Plain file list for subtitle matching, image detection etc.
    local file_list collections
    file_list=$(jq -r '.files[]?.name' <<< "$metadata")
    collections=$(item_collection_ids <<< "$metadata")

    if [[ -z "$file_list" && -z "$collections" ]]; then
        echo "${ICON_WARNING} No files found for this item or failed to fetch."
        sleep 2
        return
    fi

    # Display list with sizes: filename<TAB>size  filename
    local file_list_display
    file_list_display=$(jq -r '.files[]? |
        . as $f |
        ($f.size // "?" | tonumber? // 0) as $bytes |
        ($f.name) + "\t" +
        (if $bytes > 1073741824 then (($bytes / 1073741824 * 10 | round) / 10 | tostring) + " GB"
        elif $bytes > 1048576 then (($bytes / 1048576 * 10 | round) / 10 | tostring) + " MB"
        elif $bytes > 1024 then (($bytes / 1024 * 10 | round) / 10 | tostring) + " KB"
        else ($bytes | tostring) + " B"
        end) + "  " + $f.name' <<< "$metadata" 2>/dev/null)
    local browse_collections_key=$':browse-collections\t'
    local browse_collections_label="${ICON_PROMPT_COLLECTION} Browse collections"
    local browse_collections_row="$browse_collections_key[${CYAN}$browse_collections_label${RESET}]"

    # Helper function to extract a 'core' name for fuzzy matching
    get_core_name() {
        local input_name="$1"
        echo "$input_name" | \
        tr '[:upper:]' '[:lower:]' | \
        sed -E 's/\.[^.]*$//' | \
        tr -c '[:alnum:]' ' ' | \
        tr -s ' ' | \
        sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
    }

    # Check if item has images (excluding thumbs) for "Open all images" option
    local has_images
    has_images=$(echo "$file_list" | grep -iE '\.(jpg|jpeg|png)$' | grep -iv 'thumb')

    while true; do
        local selected_line
        selected_line=$({
            [[ -z "$collections" ]] || printf '%s\n' "$browse_collections_row"
            [[ -z "$file_list_display" ]] || printf '%s\n' "$file_list_display"
        } | fzf \
            --ansi \
            --prompt="${MAGENTA}${BOLD}${ICON_PROMPT_FILE}${RESET} Select a file to open (or press esc to go back) > " \
            --height=100% \
            --reverse \
            --border \
            --cycle \
            --delimiter=$'\t' \
            --with-nth=2.. \
            --footer="$FZF_FOOTER")

        if [ -z "$selected_line" ]; then
            return
        fi
        if [[ "$selected_line" == "$browse_collections_row" ||
              "$selected_line" == "$browse_collections_key[$browse_collections_label]" ]]; then
            local collection
            collection=$(awk '{ print $0 "\t" $0 (NR == 1 ? " (primary)" : "") }' <<< "$collections" |
                fzf --prompt="Browse collections > " --height=100% --reverse --border --cycle \
                    --delimiter=$'\t' --with-nth=2.. --footer="$FZF_FOOTER")
            if [[ -n "$collection" ]]; then
                browse_collection "${collection%%$'\t'*}"
            fi
            continue
        fi

        # Extract clean filename from column 1
        local filename
        filename=$(echo "$selected_line" | awk -F'\t' '{print $1}')

        if [ -z "$filename" ]; then
            return
        fi

       local action_label
       case "$filename" in
           *.mp4|*.mkv|*.avi|*.webm|*.flv|*.ogv|*.mp3|*.ogg|*.flac|*.wav|*.m4a)
               action_label="${CYAN}${ICON_PLAY} Play${RESET}" ;; 
           *) action_label="${CYAN}${ICON_OPEN} Open${RESET}" ;; 
       esac
       
       # Build action menu
       local action_menu
       action_menu="$action_label\n${CYAN}${ICON_DOWNLOAD} Download${RESET}"
       if [ -n "$has_images" ]; then
           action_menu+="\n${CYAN}${ICON_OPEN} Open all images${RESET}"
       fi
       action_menu+="\n${RED}${ICON_EXIT} Back to file list${RESET}"
       
       local action
       action=$(echo -e "$action_menu" | fzf \
            --ansi \
            --prompt="${MAGENTA}${BOLD}${ICON_PROMPT_ACTION}${RESET} Choose action for $filename > " \
            --height=100% \
            --reverse \
            --border \
            --cycle \
            --footer="$FZF_FOOTER")

        local sanitized_action
        sanitized_action=$(echo "$action" | sed 's/\x1b\[[0-9;]*[mG]//g')
        
        if [ -z "$action" ] || [[ "$sanitized_action" == "[${ICON_EXIT} Back to file list]" ]]; then
            continue
        fi

        local filename_encoded
        filename_encoded=$(urlencode "$filename")
        local url="https://archive.org/download/$identifier/$filename_encoded"

        if [ "$sanitized_action" == "${ICON_PLAY} Play" ] || [ "$sanitized_action" == "${ICON_OPEN} Open" ]; then
            case "$filename" in
                *.mp4|*.mkv|*.avi|*.webm|*.flv|*.ogv)
                    echo "${ICON_VIDEO} Playing video..."
                    
                  # --- Subtitle Matching Logic ---
                  local sub_file=""
                  local subtitle_candidates
                  mapfile -t subtitle_candidates < <(echo "$file_list" | grep -E '\.(srt|ass|vtt)$')
                  
                  if [ "${#subtitle_candidates[@]}" -eq 1 ]; then
                      sub_file="${subtitle_candidates[0]}"
                  
                  elif [ "${#subtitle_candidates[@]}" -gt 1 ]; then
                      local video_core_name
                      video_core_name=$(get_core_name "$filename")
                      read -ra video_words <<< "$video_core_name"
                  
                      local best_match=""
                      local best_score=0
                      local min_diff=9999
                  
                      for sub_candidate in "${subtitle_candidates[@]}"; do
                          local sub_core_name
                          sub_core_name=$(get_core_name "$sub_candidate")
                  
                          local common_word_count=0
                          for word in "${video_words[@]}"; do
                              [ -z "$word" ] && continue
                              [[ " $sub_core_name " =~ " $word " ]] && ((common_word_count++))
                          done
                  
                          local diff=$(( ${#video_core_name} > ${#sub_core_name} ? \
                              ${#video_core_name} - ${#sub_core_name} : \
                              ${#sub_core_name} - ${#video_core_name} ))
                  
                          if [ "$common_word_count" -gt "$best_score" ] || \
                             [ "$common_word_count" -eq "$best_score" ] && [ "$diff" -lt "$min_diff" ]; then
                              best_score=$common_word_count
                              min_diff=$diff
                              best_match="$sub_candidate"
                          fi
                      done
                      sub_file="$best_match"
                  fi
                  # --- End of Subtitle Matching Logic --- 

                    local mpv_log
                    mpv_log=$(mktemp)

                    if [ -n "$sub_file" ]; then
                        echo "${ICON_SUBTITLE} Found matching subtitle: $sub_file"
                        local sub_encoded
                        sub_encoded=$(urlencode "$sub_file")
                        local sub_url="https://archive.org/download/$identifier/$sub_encoded"
                        $VIDEO_PLAYER --ytdl=no "$url" --sub-file="$sub_url" > "$mpv_log" 2>&1 &
                    else
                        echo "${ICON_WARNING} No matching subtitle found."
                        $VIDEO_PLAYER --ytdl=no "$url" > "$mpv_log" 2>&1 &
                    fi 
                    
                    local pid=$!

                    (
                        for ((i=0; i<200; i++)); do
                            if ! kill -0 "$pid" 2>/dev/null; then break; fi
                            if grep -q -E "^(VO|AO):" "$mpv_log"; then break; fi
                            echo -n "."
                            sleep 0.1
                        done
                    ) | show_progress -p -t -e -N "${ICON_LAUNCH} Launching mpv" -s 200 > /dev/null

                    if ! kill -0 "$pid" 2>/dev/null; then
                        echo "${ICON_WARNING} mpv failed to launch. Error log:"
                        echo "-------------------------------------"
                        cat "$mpv_log"
                        echo "-------------------------------------"
                        echo "Press Enter to continue."
                        read -r
                    fi

                    rm -f "$mpv_log"
                    ;;

                *.mp3|*.ogg|*.flac|*.wav|*.m4a)
                    echo "${ICON_AUDIO} Playing audio..."
                    $AUDIO_PLAYER "$url" >/dev/null 2>&1 &
                    ;;
                *.png|*.jpg|*.jpeg|*.gif|*.bmp)
                    download_and_view "$url" "$IMAGE_VIEWER" ;; 
                *.pdf)
                    download_and_view "$url" "$PDF_VIEWER" ;; 
                *.epub)
                    download_and_view "$url" "$EPUB_VIEWER" ;;
                *.[cC][bB][zZ])
                    download_and_view "$url" "$CBZ_VIEWER" .cbz ;;
                *.txt|*.md|*.rst|*.csv|*.log|*.tex|*.sh|*.py|*.c|*.cpp|*.h|*.java|*.js|*.ts|*.json|*.xml|*.yaml|*.yml|*.ini|*.conf|*.cfg)
                    local temp_file
                    temp_file=$(mktemp)
                    curl -sL "$url" -o "$temp_file"
                    if [ -s "$temp_file" ]; then
                        $TEXT_VIEWER "$temp_file"
                        rm -f "$temp_file"
                    else
                        echo "${ICON_WARNING} Failed to fetch $filename"
                    fi ;; 
                *)
                    xdg-open "$url" >/dev/null 2>&1 &
                    ;;
            esac
        elif [ "$sanitized_action" == "${ICON_DOWNLOAD} Download" ]; then
            local download_status
            local download_dir="$DOWNLOAD_BASE_DIR/$identifier"
            if ! mkdir -p "$download_dir/$(dirname -- "$filename")"; then
                echo "${ICON_ERROR} Cannot create download directory: $download_dir"
                read -r -p "Press Enter to continue."
                continue
            fi
            case "$filename" in
                *.mp4|*.mkv|*.avi|*.webm|*.flv|*.ogv)
                    "$VIDEO_DOWNLOADER" --paths "$download_dir" --output '%(title).180B.%(ext)s' "$url"
                    download_status=$? ;;
                *)
                    curl -fL -o "$download_dir/$filename" "$url"
                    download_status=$? ;;
            esac
            if [ "$download_status" -eq 0 ]; then
                echo "${ICON_SUCCESS} Saved in: $download_dir"
                echo "Press Enter to continue."
            else
                echo "${ICON_ERROR} Download failed. Press Enter to continue."
            fi
            read -r
        elif [ "$sanitized_action" == "${ICON_OPEN} Open all images" ]; then
            open_all_images "$identifier" "$file_list"
        fi
    done
}

# --- Argument Parsing ---
if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
fi

# --- Main ---
check_deps
show_collections
echo "${ICON_GOODBYE} Goodbye."
exit 0
