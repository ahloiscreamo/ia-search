subject:"japanese cinema"
mediatype:movies AND language:jpn
mediatype:movies AND language:chi
mediatype:movies AND creator:"wong kar wai"
mediatype:movies AND creator:"edward yang"
mediatype:movies AND creator:"yasujiro ozu"
mediatype:movies AND title:"blind beast"
mediatype:audio AND subject:album
mediatype:image AND subject:magazine
mediatype:texts AND subject:linux
mediatype:texts AND language:jpn AND subject:magazine
collection:magazine_rack AND language:jpn
subject:gravure AND mediatype:image
uploader:some_username'       

            full_list=$(printf "%s\n%s" "$history_content" "$examples" | awk '!b[$0]++ {if (NF) print}')

            # --- Get query from fzf ---
            query=$(printf "%s\n" "$full_list" | fzf --ansi \
                --prompt="${MAGENTA}${BOLD}${ICON_SEARCH}${RESET} Type search query (ESC to return) > " \
                --print-query \
                --height=100% \
                --reverse \
                --border \
                --cycle \
                --bind 'ctrl-e:print-query' \
                --footer="$FZF_FOOTER_SEARCH")
       
            query=$(echo "$query" | tail -n 1)

            [ -z "$query" ] && return 0

            # --- Update history file ---
            if [ -s "$IA_SEARCH_HISTORY_FILE" ]; then
                grep -Fxv -- "$query" "$IA_SEARCH_HISTORY_FILE" > "${IA_SEARCH_HISTORY_FILE}.tmp" && \
                mv "${IA_SEARCH_HISTORY_FILE}.tmp" "$IA_SEARCH_HISTORY_FILE"
            fi
            echo "$query" >> "$IA_SEARCH_HISTORY_FILE"
        fi

        local final_query
        if [[ "$query" != *":"* ]]; then
            final_query="title:\"$query\""
        else
            final_query="$query"
        fi
        
        page=1
        rows=28
        query_id=$(favorite_query_id "$query") || return 1
        searched_collection=
        favorite_status=
        if [[ "$final_query" =~ ^collection:([[:alnum:]_.-]+)([[:space:]]+AND[[:space:]]|$) ||
              "$final_query" =~ ^collection:\"([[:alnum:]_.-]+)\"([[:space:]]+AND[[:space:]]|$) ]]; then
            searched_collection=${BASH_REMATCH[1]}
        fi

        while true; do
            echo "${ICON_SEARCH} Searching for \"$query\" (Page $page)..."
            
            local query_hash
            query_hash=$(echo -n "$final_query" | md5sum | cut -d' ' -f1)
            local cache_file="$SEARCH_CACHE_DIR/${query_hash}-page-${page}.json"

            if [ -f "$cache_file" ]; then
                item_json=$(cat "$cache_file")
            else
                if ! item_json=$(ia search "$final_query" --field identifier --field title --sort "downloads desc" -p "page:$page" -p "rows:$rows"); then
                    echo "${ICON_ERROR} Error: 'ia search' command failed for query: $final_query. Check connection or command."
                    sleep 3
                    break
                fi
                echo "$item_json" > "$cache_file"

            fi
            if [ -z "$item_json" ]; then
                echo "${ICON_WARNING} No results found for page $page."
            fi
            
            # Format as: identifier<TAB>title
            mapfile -t items < <(echo "$item_json" | jq -s -r '.[] | "\(.identifier)\t\(.title)"')

            # Build choices with uniform ID<TAB>TEXT format
            choices=()
            if [[ -n "$searched_collection" ]]; then
                choices+=("$(favorite_action_row "$searched_collection" action_favorite_collection \
                    "Add $searched_collection to Favorites" "Remove $searched_collection from Favorites")")
            fi
            
            choices+=("$(favorite_action_row "$query_id" action_save_search \
                "Save this search" "Remove this search from Favorites")")
            if [ "${#items[@]}" -eq "$rows" ]; then
                choices+=($'action_next_page\t'"[${BLUE}${ICON_NEXT} Next page${RESET}]")
            fi
            if [ "$page" -gt 1 ]; then
                 choices+=($'action_prev_page\t'"[${BLUE}${ICON_PREV} Previous page${RESET}]")
            fi
            choices+=($'action_refresh\t'"[${CYAN}${ICON_REFRESH} Refresh page${RESET}]")
            choices+=($'action_search_all\t'"[${YELLOW}${ICON_SEARCH} Search all results${RESET}]")
            choices+=($'action_back\t'"[${RED}${ICON_EXIT} Back to main${RESET}]")

            # Use a simple empty string for the gap, like the original script
            if [ "${#choices[@]}" -gt 0 ]; then
                choices+=("")
            fi

            choices+=("${items[@]}")

            search_label="${MAGENTA}${BOLD}${ICON_PROMPT_TITLE} Search: $query · Page $page${RESET}"
            if [[ -n "$favorite_status" ]]; then
                search_label+=" · $favorite_status"
            fi

            selected_line=$(printf '%s\n' "${choices[@]}" | fzf \
                --ansi \
                --prompt="Filter results > " \
                --height=100% \
                --reverse \
                --border \
                --border-label=" $search_label " \
                --border-label-pos=2 \
                --delimiter=$'\t' \
                --with-nth=2.. \
                --preview-window=right:50% \
                --preview "$preview_command" \
                --cycle \
                --sync --expect=ctrl-b --footer="$FZF_FOOTER_FAVORITES")
            
            key=${selected_line%%$'
'*}
            selected_line=${selected_line#*$'
'}
            identifier_or_action=${selected_line%%$'\t'*}
            favorite_status=
            if [[ "$identifier_or_action" == action_save_search ]]; then
                favorite_status=$(toggle_favorite "$query_id" "$query")
                continue
            fi
            if [[ "$identifier_or_action" == action_favorite_collection ]]; then
                favorite_status=$(toggle_search_favorite "$searched_collection"$'\t')
                continue
            fi
            if [[ "$key" == ctrl-b ]]; then
                favorite_status=$(toggle_search_favorite "$selected_line")
                continue
            fi

            if [ -z "$identifier_or_action" ]; then
                break
            fi

            case "$identifier_or_action" in
                "action_refresh")
                    if [ -f "$cache_file" ]; then
                        rm "$cache_file"
                        echo "${ICON_SUCCESS} Page cache cleared. Refreshing..."
                    fi
                    continue
                    ;;
                "action_next_page")
                    ((page++))
                    ;;
                "action_prev_page")
                    if [ "$page" -gt 1 ]; then
                        ((page--))
                    fi
                    ;;
                "action_search_all")
                    local sub_query_text
                    sub_query_text=$(printf '' | fzf --ansi \
                        --prompt="${MAGENTA}${BOLD}${ICON_SEARCH}${RESET} Search within results for '$query': " \
                        --print-query \
                        --height=10 \
                        --reverse \
                        --border \
                        --footer="$FZF_FOOTER_SEARCH" | head -n1)
                    [ -z "$sub_query_text" ] && continue

                    local sub_query_fragment
                    if [[ "$sub_query_text" != *":"* ]]; then
                        sub_query_fragment="title:\"$sub_query_text\""
                    else
                        sub_query_fragment="$sub_query_text"
                    fi

                    echo "${ICON_SEARCH} Searching for \"$query AND $sub_query_text\"..."
                    local combined_query="$final_query AND $sub_query_fragment"
                    local total_combined_hits
                    total_combined_hits=$(ia search "$combined_query" --num-found)

                    if [ -z "$total_combined_hits" ] || [ "$total_combined_hits" -eq 0 ]; then
                        echo "${ICON_WARNING} No results found for \"$combined_query\"."
                        continue
                    fi

                    echo "${ICON_SEARCH} Loading all $total_combined_hits results for \"$combined_query\"..."
                    
                    local temp_combined_file
                    temp_combined_file=$(mktemp)
                    
                    local combined_query_hash
                    combined_query_hash=$(echo -n "$combined_query" | md5sum | cut -d' ' -f1)
                    local cache_file="$SEARCH_CACHE_DIR/${combined_query_hash}-all.json"

                    if [ -f "$cache_file" ]; then
                        show_progress -N "Loading from cache" "$cache_file" > "$temp_combined_file"
                    else
                        (ia search "$combined_query" --field identifier --field title | tee "$cache_file" | show_progress -l -s "$total_combined_hits" -N "Loading combined" > "$temp_combined_file")
                    fi
                    
                    local selected_sub_item_line combined_query_id
                    combined_query_id=$(favorite_query_id "$combined_query") || return 1
                    selected_sub_item_line=$({
                        favorite_action_row "$combined_query_id" action_save_search \
                            "Save this search" "Remove this search from Favorites"
                        jq -s -r '.[] | "\(.identifier)\t\(.title)"' "$temp_combined_file"
                    } | fzf \
                        --ansi \
                        --prompt="Filter results > " \
                        --height=100% \
                        --reverse \
                        --border \
                        --border-label=" ${MAGENTA}${BOLD}${ICON_PROMPT_TITLE} Search: $combined_query${RESET} " \
                        --border-label-pos=2 \
                        --delimiter=$'\t' \
                        --with-nth=2.. \
                        --preview-window=right:50% \
                        --preview "$preview_command" \
                        --cycle \
                        --sync --expect=ctrl-b --footer="$FZF_FOOTER_FAVORITES")
                    
                    rm "$temp_combined_file"

                    key=${selected_sub_item_line%%$'
'*}
                    selected_sub_item_line=${selected_sub_item_line#*$'
'}
                    if [[ "${selected_sub_item_line%%$'\t'*}" == action_save_search ]]; then
                        favorite_status=$(toggle_favorite "$combined_query_id" "$combined_query")
                        continue
                    fi
                    if [[ "$key" == ctrl-b ]]; then
                        favorite_status=$(toggle_search_favorite "$selected_sub_item_line")
                        continue
                    elif [ -n "$selected_sub_item_line" ]; then
                        local final_identifier
                        final_identifier=$(echo "$selected_sub_item_line" | awk 'BEGIN{FS="\t"} {print $1}')
                        open_item "$final_identifier"
                    fi
                    break
                    ;;
                "action_back")
                    return
                    ;;
                *)
                    [ -z "$identifier_or_action" ] && continue
                    open_item "$identifier_or_action"
                    ;;
            esac
        done
        [[ -z "$saved_query" ]] || return 0
    done
}

