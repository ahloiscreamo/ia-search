# --- Helper: Download and View ---
download_and_view() {
    local url="$1"
    local viewer="$2"
    local suffix="${3:-}"
    (
        local temp_file
        temp_file=$(mktemp --suffix="$suffix") || exit 1
        trap 'rm -f "$temp_file"' INT TERM EXIT

        echo "${ICON_WAIT} Downloading to view..."
        curl -sL "$url" | show_progress > "$temp_file"

        if [ -s "$temp_file" ]; then
            "$viewer" "$temp_file" >/dev/null 2>&1
            rm -f "$temp_file"
        else
            echo "${ICON_WARNING} Failed to download file for viewing."
            rm -f "$temp_file"
        fi
    )
}

# --- Open All Images ---
open_all_images() {
    local identifier="$1"
    local file_list="$2"
    # Filter images, exclude thumbs
    mapfile -t image_files < <(echo "$file_list" | grep -iE '\.(jpg|jpeg|png)$' | grep -iv 'thumb')
    if [ "${#image_files[@]}" -eq 0 ]; then
        echo "${ICON_WARNING} No images found for this item."
        sleep 2
        return
    fi
    echo "${ICON_IMAGE} Found ${#image_files[@]} images. Downloading..."
    local temp_dir
    local item_dir="$DOWNLOAD_BASE_DIR/$identifier"
    mkdir -p "$item_dir" || return 1
    # Isolate image cleanup from other saved downloads for this item.
    temp_dir=$(mktemp -d "$item_dir/images-XXXXXX") || return 1
    # Download using ia download
    (ia download "$identifier" \
        --destdir="$temp_dir" \
        --no-directories) &
    local dl_pid=$!
    # Show progress while downloading
    while kill -0 "$dl_pid" 2>/dev/null; do
        local count
        count=$(find "$temp_dir" -type f | wc -l)
        echo -ne "\r${ICON_WAIT} Downloaded $count/${#image_files[@]} files..."
        sleep 0.5
    done
    wait "$dl_pid"
    echo ""
    # Keep only image files, remove thumbs and everything else
    find "$temp_dir" -type f ! -iname "*.jpg" ! -iname "*.jpeg" ! -iname "*.png" -delete
    find "$temp_dir" -type f -iname "*thumb*" -delete
    local downloaded
    downloaded=$(find "$temp_dir" -type f | wc -l)
    if [ "$downloaded" -eq 0 ]; then
        echo "${ICON_WARNING} Failed to download images."
        rm -rf "$temp_dir"
        sleep 2
        return
    fi
    echo "${ICON_SUCCESS} Downloaded $downloaded images. Opening with $IMAGE_VIEWER..."
    "$IMAGE_VIEWER" "$temp_dir" >/dev/null 2>&1
    # After viewer closes, prompt keep or delete
    echo ""
    read -r -p "Keep downloaded files? [y/N] " response
    if [[ "$response" =~ ^[Yy]$ ]]; then
        echo "${ICON_SUCCESS} Files kept at: $temp_dir"
    else
        rm -rf "$temp_dir"
        echo "${ICON_SUCCESS} Cleaned up."
    fi
}

# --- URL Encode ---
urlencode() {
    python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1], safe='/-_.~'))" "$1"
}

# --- Help Function ---
usage() {
    cat << EOF
ia-search - Interactive Internet Archive Browser & Downloader

USAGE:
    ia-search [OPTIONS]

DESCRIPTION:
    A script to interactively browse, search, and download files from the Internet Archive.

OPTIONS:
    -h, --help    Show this help message and exit.

SEARCH SYNTAX:
    The search prompt accepts standard Internet Archive advanced search queries.
    You can combine terms with AND, OR, and NOT. Queries are in the format:

    field:value

    --- Common Searchable Metadata Fields ---
    The Internet Archive allows searching against many different metadata fields.
    The most common and reliable fields to use in your queries include:

    - mediatype:   The primary content type/category of the item.
                   Example: mediatype:movies
    - title:       The title of the work.
                   Example: title:"Floating weeds"
    - creator:     The person or entity that created the work.
                   Example: creator:"yasujiro ozu"
    - uploader:    The account that uploaded the item to the Archive.
                   Example: uploader:username
    - subject:     Keywords, topics, or themes describing the content.
                   Example: subject:"japanese cinema"
    - collection:  The collection(s) the item belongs to.
                   Example: collection:vhsmovies
    - date:        The publication date (often YYYY or YYYY-MM-DD).
                   Example: date:[1980 TO 1989]
    - language:    The language of the item's content.
                   Example: language:jpn
    - identifier:  The unique ID of the item (the last part of the URL).
                   Example: identifier:openlibrary
    - format:      The file format(s) available for the item.
                   Example: format:pdf or format:epub

    --- Full List of mediatype Values ---
    The 'mediatype' organizes the site's content into major categories.
    These are the most relevant and valid values you should use:

    - texts        (Books, documents, magazines, etc.)
    - audio        (General audio, including music, podcasts, etc.)
    - movies       (Video files, films, cartoons, public affairs)
    - software     (Historical software, games, applications)
    - image        (Photos, artwork, historical images)
    - data         (Datasets and raw data files)
    - web          (Web archives, including Wayback Machine captures)

    Note: You may sometimes see 'etree' (specialized audio) or 'collection' or 'account',
          but the list above covers the main content categories.

    --- language Values (ISO 639-2 Codes) ---
    The values for the 'language' field use three-character lowercase codes
    based on the ISO 639-2 standard.

    For example, for Japanese, use: language:jpn

    Some common examples of three-letter language codes:
    - English:  eng
    - Japanese: jpn
    - French:   fre or fra
    - German:   ger or deu
    - Chinese:  chi or zho
    - Spanish:  spa
    - Russian:  rus
    - Italian:  ita
    - Korean:   kor

    For a full list of these codes, search for "ISO 639-2 language codes".

    --- Query Syntax Recap ---
    Remember you can combine these fields using Boolean operators:

    - AND: Narrows the search (e.g., mediatype:movies AND language:jpn)
    - OR:  Widens the search (e.g., language:eng OR language:fre)
    - NOT: Excludes items (e.g., mediatype:texts AND NOT collection:gutenberg)

KEYBINDINGS:
    In the search prompt:
    Ctrl+E    Submit exactly what you typed, ignoring any highlighted history item.
    ESC       Return to the previous menu.

    In all fzf menus:
    ESC       Go back to the previous level.
    Enter     Select the highlighted item.

    In Top Collections, Favorites, and search results:
    Ctrl+B    Add or remove the highlighted collection from Favorites.

    Collection and search actions show a filled star when saved.
    Select Save this search to keep the full query and its filters.

    Favorites are saved in ${XDG_CONFIG_HOME:-$HOME/.config}/ia-search/collections.list.

DEPENDENCIES:
    fzf, jq, curl, ia, pv, mpv, zathura, yt-dlp, python3, vim
    CBZ: zathura-cb plugin.
    Favorites: flock (util-linux).
    Images: swayimg, imv, or imv-dir on Wayland; nsxiv or sxiv on X11.
EOF
    exit 0
}

# --- Favorites ---
favorite_exists() {
    [[ -f "$FAVORITES_FILE" ]] &&
        awk -F '[\t\r]' -v id="$1" '$1 == id { found=1; exit } END { exit !found }' "$FAVORITES_FILE"
}

favorite_action_row() {
    local identifier="$1" action="$2" add_label="$3" remove_label="$4"
    local icon="$ICON_FAVORITE_EMPTY" label="$add_label"
    if favorite_exists "$identifier"; then
        icon="$ICON_FAVORITE"
        label="$remove_label"
    fi
    printf '%s\t[%s%s %s%s]\n' "$action" "$YELLOW" "$icon" "$label" "$RESET"
}

toggle_favorite() {
    local identifier="$1" title="$2" operation="${3:-toggle}"

    if ! mkdir -p -- "$FAVORITES_DIR" || ! (
        flock -x 9 || exit 1

        local temp_file
        temp_file=$(mktemp "$FAVORITES_DIR/.favorites.XXXXXX") || exit 1
        trap 'rm -f -- "$temp_file"' EXIT

        if [[ -f "$FAVORITES_FILE" ]]; then
            if favorite_exists "$identifier"; then
                if [[ "$operation" == save ]]; then
                    echo "${ICON_INFO} Already in Favorites: $title"
                    exit 0
                fi
                awk -F '[\t\r]' -v id="$identifier" '$1 != id' "$FAVORITES_FILE" > "$temp_file" || exit 1
                mv -- "$temp_file" "$FAVORITES_FILE" || exit 1
                echo "${ICON_SUCCESS} Removed from Favorites: $title"
                exit 0
            fi
            awk '1' "$FAVORITES_FILE" > "$temp_file" || exit 1
        fi

        [[ "$operation" == remove ]] && exit 0
        title=${title//$'\t'/ }
        title=${title//$'\r'/ }
        title=${title//$'\n'/ }
        printf '%s\t%s\n' "$identifier" "${title:-$identifier}" >> "$temp_file" &&
            mv -- "$temp_file" "$FAVORITES_FILE" || exit 1
        echo "${ICON_SUCCESS} Added to Favorites: $title"
    ) 9>"$FAVORITES_DIR/favorites.lock"; then
        echo "${ICON_ERROR} Could not update Favorites."
    fi
}

toggle_search_favorite() {
    local entry="$1" identifier title metadata media_type
    identifier=${entry%%$'\t'*}
    [[ "$entry" == *$'\t'* && "$identifier" != action_* ]] || return 0
    title=${entry#*$'\t'}

    if favorite_exists "$identifier"; then
        toggle_favorite "$identifier" "${title:-$identifier}" remove
        return
    fi

    if ! metadata=$(curl -fsSL "https://archive.org/metadata/$(urlencode "$identifier")" 2>/dev/null) ||
        ! media_type=$(jq -er '.metadata.mediatype' <<< "$metadata" 2>/dev/null); then
        echo "${ICON_WARNING} Could not check the media type for $identifier."
    elif [[ "$media_type" == collection ]]; then
        if [[ -z "$title" ]]; then
            title=$(jq -r '.metadata.title | if type == "array" then .[0] else . end // empty' <<< "$metadata")
        fi
        toggle_favorite "$identifier" "${title:-$identifier}" save
    else
        echo "${ICON_WARNING} Only collections can be added to Favorites."
    fi
}

favorite_query_id() {
    printf ':search:'
    printf '%s' "$1" | base64 -w0
}

show_favorites() {
    local entries selection key entry identifier query
    while true; do
        entries=""
        if [[ -f "$FAVORITES_FILE" ]]; then
            entries=$(awk -F '\t' '/^[[:space:]]*(#|$)/ { next }
                {
                    sub(/\r$/, "")
                    title = ($2 == "" ? $1 : $2)
                    print $1 "\t" ($1 ~ /^:search:/ ? "[Search] " : "") title
                }' "$FAVORITES_FILE") || return 1
        fi
        if [[ -z "$entries" ]]; then
            echo "${ICON_INFO} No favorites yet. Save a search or press Ctrl+B on a collection."
            return 0
        fi
        selection=$(fzf --height=100% --reverse --border --cycle \
            --prompt="${ICON_PROMPT_COLLECTION} Favorites > " \
            --delimiter=$'\t' --with-nth=2.. --sync --expect=ctrl-b \
            --footer="$FZF_FOOTER | Ctrl+B to remove favorite" <<< "$entries") || return 0
        key=${selection%%$'\n'*}
        entry=${selection#*$'\n'}
        [[ "$entry" == *$'\t'* ]] || return 0
        identifier=${entry%%$'\t'*}

        if [[ "$key" == ctrl-b ]]; then
            toggle_favorite "$identifier" "${entry#*$'\t'}" remove
        elif [[ "$identifier" == :search:* ]]; then
            if query=$(printf '%s' "${identifier#:search:}" | base64 -d) && [[ -n "$query" ]]; then
                search_mode "$query"
            fi
        else
            browse_collection "$identifier"
        fi
    done
}

# --- Show Collections ---
show_collections() {
    local PAGE_SIZE=28
    local page=0

    fetch_collections() {
        echo "${ICON_PROMPT_COLLECTION} Fetching top collections from Internet Archive..."
        local fetched_json
        fetched_json=$(curl -sG "$API_URL" \
            --data-urlencode "q=mediatype:collection" \
            --data-urlencode "fl[]=identifier" \
            --data-urlencode "fl[]=title" \
            --data-urlencode "fl[]=description" \
            --data-urlencode "sort[]=downloads desc" \
            --data-urlencode "rows=500" \
            --data-urlencode "output=json")
        
        if [ $? -ne 0 ] || [ -z "$fetched_json" ]; then
            echo "${ICON_ERROR} Error: Failed to fetch collections from the Internet Archive."
            return 1
        fi

        if ! echo "$fetched_json" | jq -e . >/dev/null 2>&1; then
            echo "${ICON_ERROR} Error: Corrupt response received from the API."
            return 1
        fi
        
        json="$fetched_json" # Update parent scope variable
        echo "$json" > "$TOP_COLLECTIONS_CACHE_FILE"
        return 0
    }

    local json selection key entry identifier
    local -a all_entries choices
    if [ -f "$TOP_COLLECTIONS_CACHE_FILE" ] && [ $(( $(date +%s) - $(stat -c %Y "$TOP_COLLECTIONS_CACHE_FILE") )) -lt $CACHE_EXPIRY ]; then
        echo "${ICON_PROMPT_COLLECTION} Loading collections from cache..."
        json=$(cat "$TOP_COLLECTIONS_CACHE_FILE")
    else
        fetch_collections || json='{"response":{"docs":[]}}'
    fi

    while true; do
        mapfile -t all_entries < <(jq -r '.response.docs[] |
            .identifier as $id |
            ((.title // $id) | gsub("[\t\r\n]"; " ")) as $title |
            [$id, "\($title) [\($id)]", $title] | join("\t")' <<< "$json")
        local total_pages=$(( (${#all_entries[@]} + PAGE_SIZE - 1) / PAGE_SIZE ))
        (( total_pages > 0 )) || total_pages=1
        local start=$(( page * PAGE_SIZE ))
        choices=(
            $':search\t'"[${YELLOW}${ICON_SEARCH}${RESET} Search all collections]"
            $':favorites\t'"[${CYAN}${ICON_OPEN}${RESET} Favorites]"
            $':refresh\t'"[${BLUE}${ICON_REFRESH}${RESET} Refresh cache]"
            ""
        )
        choices+=("${all_entries[@]:start:PAGE_SIZE}")
        choices+=("")
        if (( page > 0 )); then
            choices+=($':prev\t'"[${BLUE}${ICON_PREV}${RESET} Previous page]")
        fi
        if (( page + 1 < total_pages )); then
            choices+=($':next\t'"[${BLUE}${ICON_NEXT}${RESET} Next page]")
        fi
        choices+=($':exit\t'"[${RED}${ICON_EXIT}${RESET} Exit]")

        selection=$(printf '%s\n' "${choices[@]}" | fzf \
            --ansi \
            --prompt="${MAGENTA}${BOLD}${ICON_PROMPT_COLLECTION}${RESET} Select collection (Page $((page+1))/${total_pages}) > " \
            --height=100% --reverse --border --cycle \
            --delimiter=$'\t' --with-nth=2 --sync --expect=ctrl-b \
            --footer="$FZF_FOOTER_FAVORITES")
        key=${selection%%$'\n'*}
        entry=${selection#*$'\n'}
        identifier=${entry%%$'\t'*}

        if [[ "$key" == ctrl-b ]]; then
            if [[ "$entry" == *$'\t'* && -n "$identifier" && "$identifier" != :* ]]; then
                toggle_favorite "$identifier" "${entry##*$'\t'}"
            fi
            continue
        fi

        case "$identifier" in
            :refresh)
                if fetch_collections; then
                    page=0
                    echo "${ICON_SUCCESS} Cache refreshed."
                fi
                ;;
            :search) search_mode ;;
            :favorites) show_favorites ;;
            :next) ((page++)) ;;
            :prev) ((page--)) ;;
            :exit) break ;;
            "")
                if (( page == 0 )); then break; fi
                ((page--))
                ;;
            *) browse_collection "$identifier" ;;
        esac
    done
}

# --- Search Mode ---
search_mode() {
