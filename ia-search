        else
            # --- Prepare history and examples for fzf ---
            local full_list=""
            local history_content=""
            if [ -s "$IA_SEARCH_HISTORY_FILE" ]; then
                history_content=$(tac "$IA_SEARCH_HISTORY_FILE" | awk '!a[$0]++' | head -n 20)
            fi

            local examples='collection:anime_miscellaneous
title:irezumi
