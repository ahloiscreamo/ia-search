# Prefer a native viewer for the current desktop session.
select_image_viewer() {
    local candidate
    local -a candidates
    if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]] || { [[ "${XDG_SESSION_TYPE:-}" != "x11" ]] && [[ -n "${WAYLAND_DISPLAY:-}" ]]; }; then
        candidates=(swayimg imv imv-dir)
    else
        candidates=(nsxiv sxiv)
    fi
    IMAGE_VIEWER="${candidates[0]}"
    for candidate in "${candidates[@]}"; do
        if command -v "$candidate" >/dev/null 2>&1; then
            IMAGE_VIEWER="$candidate"
            return 0
        fi
    done
}
