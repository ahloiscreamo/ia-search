# --- Dependency Check ---
check_deps() {
    local missing=0
    for cmd in fzf jq curl ia pv mpv "$IMAGE_VIEWER" zathura yt-dlp python3 vim; do
        if ! command -v "$cmd" &> /dev/null; then
            echo "${ICON_ERROR} Error: Required command '$cmd' is not installed."
            missing=1
        fi
    done
    [ "$missing" -eq 1 ] && exit 1
}

item_collection_ids() {
    jq -r '.metadata.collection |
        if type == "array" then .[] else . end |
        strings | select(test("^[A-Za-z0-9_.-]+$"))' |
        awk '!seen[$0]++'
}

# --- FZF Previewer ---
# Caches and displays file list with sizes for fzf previews
fzf_previewer() {
    local item_text="$1"

    if [ -z "$item_text" ]; then
        return
    fi
    
    local identifier
    identifier=$(echo "$item_text" | awk -F'\t' '{print $1}')

    if [[ "$identifier" == action_* ]]; then
        echo "Navigate with Enter. No item preview for options."
        return
    fi

    if [ -z "$identifier" ]; then
        return
    fi

    [[ "$identifier" =~ ^[A-Za-z0-9_.-]+$ ]] || return
    local cache_file="$PREVIEW_CACHE_DIR/$identifier.txt"
    
    if [ -s "$cache_file" ]; then
        cat "$cache_file"
    else
        local metadata collections list_output preview_output
        if ! metadata=$(curl -fsSL "https://archive.org/metadata/$identifier" 2>/dev/null) ||
            ! jq -e 'type == "object"' >/dev/null 2>&1 <<< "$metadata"; then
            echo "-- Failed to fetch metadata --"
            return
        fi

        collections=$(item_collection_ids <<< "$metadata")
        list_output=$(jq -r '(.files // [])[:20][] |
            . as $f | 
            ($f.size // "?" | tonumber? // 0) as $bytes |
            if $bytes > 1073741824 then (($bytes / 1073741824 * 10 | round) / 10 | tostring) + " GB"
            elif $bytes > 1048576 then (($bytes / 1048576 * 10 | round) / 10 | tostring) + " MB"
            elif $bytes > 1024 then (($bytes / 1024 * 10 | round) / 10 | tostring) + " KB"
            else ($bytes | tostring) + " B"
            end + "\t" + $f.name' <<< "$metadata" 2>/dev/null |
            column -t -s $'\t')

        preview_output="${list_output:--- No files found for this item --}"
        if [[ -n "$collections" ]]; then
            preview_output="Collections: $(awk 'NR > 1 { printf ", " } { printf "%s", $0 }' <<< "$collections")"$'\n\n'"$preview_output"
        fi
        printf '%s\n' "$preview_output" > "$cache_file"
        printf '%s\n' "$preview_output"
    fi
}
export -f fzf_previewer item_collection_ids

